{
  "expo": {
    "name": "Poulina AI OpsHub",
    "slug": "poulina-ops-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/poulina-logo.png",
    "scheme": "poulina-ops",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/poulina-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#204e8f"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/poulina-logo.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.poulina.aiopshub"
    },
    "android": {
      "icon": "./assets/images/poulina-logo.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/poulina-logo.png",
        "backgroundColor": "#204e8f"
      },
      "usesCleartextTraffic": true,
      "package": "com.poulina.aiopshub"
    },
    "web": {
      "favicon": "./assets/images/poulina-logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d1fbc705-05fc-43a8-9c9b-9e1ce26fc8f4"
      }
    }
  }
}
